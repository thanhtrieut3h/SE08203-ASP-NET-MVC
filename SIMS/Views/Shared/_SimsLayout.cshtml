@{
}
<!DOCTYPE html>
<html lang="en">
<head>
    @* <base href="./"> *@
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <meta name="description" content="Student information management system">
    <meta name="author" content="SE08203 - BTec">
    <meta name="keyword" content="Student,Teacher,Course,Class">
    <title>@ViewData["Title"] - SIMS</title>
    <link rel="apple-touch-icon" sizes="57x57" href="~/sims/assets/favicon/apple-icon-57x57.png">
    <link rel="apple-touch-icon" sizes="60x60" href="~/sims/assets/favicon/apple-icon-60x60.png">
    <link rel="apple-touch-icon" sizes="72x72" href="~/sims/assets/favicon/apple-icon-72x72.png">
    <link rel="apple-touch-icon" sizes="76x76" href="~/sims/assets/favicon/apple-icon-76x76.png">
    <link rel="apple-touch-icon" sizes="114x114" href="~/sims/assets/favicon/apple-icon-114x114.png">
    <link rel="apple-touch-icon" sizes="120x120" href="~/sims/assets/favicon/apple-icon-120x120.png">
    <link rel="apple-touch-icon" sizes="144x144" href="~/sims/assets/favicon/apple-icon-144x144.png">
    <link rel="apple-touch-icon" sizes="152x152" href="~/sims/assets/favicon/apple-icon-152x152.png">
    <link rel="apple-touch-icon" sizes="180x180" href="~/sims/assets/favicon/apple-icon-180x180.png">
    <link rel="icon" type="image/png" sizes="192x192" href="~/sims/assets/favicon/android-icon-192x192.png">
    <link rel="icon" type="image/png" sizes="32x32" href="~/sims/assets/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="96x96" href="~/sims/assets/favicon/favicon-96x96.png">
    <link rel="icon" type="image/png" sizes="16x16" href="~/sims/assets/favicon/favicon-16x16.png">
    <link rel="manifest" href="~/sims/assets/favicon/manifest.json">
    <meta name="msapplication-TileColor" content="#ffffff">
    <meta name="msapplication-TileImage" content="~/sims/assets/favicon/ms-icon-144x144.png">
    <meta name="theme-color" content="#ffffff">
    <!-- Vendors styles-->
    <link rel="stylesheet" href="~/sims/vendors/simplebar/css/simplebar.css">
    <link rel="stylesheet" href="~/sims/css/vendors/simplebar.css">
    <!-- Main styles for this application-->
    <link href="~/sims/css/style.css" rel="stylesheet">
    <!-- We use those styles to show code examples, you should remove them in your application.-->
    @await RenderSectionAsync("stylesheets", required: false)
    <script src="~/sims/js/config.js"></script>
    <script src="~/sims/js/color-modes.js"></script>
    <link href="~/sims/vendors/coreui/chartjs/css/coreui-chartjs.css" rel="stylesheet">
</head>
<body>
    <partial name="Partials/_Sidebar" />
    <div class="wrapper d-flex flex-column min-vh-100">
        <partial name="Partials/_Header" />
        <div class="body flex-grow-1">
            <div class="container-lg px-4">
                @RenderBody()
            </div>
        </div>
        <partial name="Partials/_Footer" />
    </div>
    <!-- CoreUI and necessary plugins-->
    <script src="~/sims/vendors/coreui/coreui/js/coreui.bundle.min.js"></script>
    <script src="~/sims/vendors/simplebar/js/simplebar.min.js"></script>
    <script>
        const header = document.querySelector("header.header");

        document.addEventListener("scroll", () => {
          if (header) {
            header.classList.toggle("shadow-sm", document.documentElement.scrollTop > 0);
          }
        });
    </script>
    <!-- Plugins and scripts required by this view-->
    @* <script src="vendors/chart.js/js/chart.umd.js"></script>
    <script src="vendors/coreui/chartjs/js/coreui-chartjs.js"></script>
    <script src="vendors/coreui/utils/js/index.js"></script> *@
    <script src="~/sims/js/main.js"></script>
    @await RenderSectionAsync("javascripts", required: false)
</body>
</html>
